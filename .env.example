APP_NAME="Party Sites CMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://yourparty.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=party_cms
DB_USERNAME=party_cms_user
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contact@yourparty.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- CMS-specific ---
# production | demo | local
CMS_INSTANCE=production
CMS_PRODUCT_NAME="Party Sites CMS"
CMS_PANEL_PATH=panel

# AI translation: enter the party's own Anthropic API key to enable.
# Leave blank to hide the translation button entirely.
CMS_ANTHROPIC_API_KEY=

# CRM integration (all optional)
CMS_CRM_URL=
CMS_CRM_SSO_SECRET=
CMS_CRM_API_KEY=

# Demo instance: comma-separated emails that may receive real mail.
CMS_DEMO_MAIL_ALLOWLIST=

# Demo login credentials shown on /demo — required when CMS_INSTANCE=demo.
CMS_DEMO_LOGIN_EMAIL=demo@yourparty.example.com
CMS_DEMO_LOGIN_PASSWORD=
